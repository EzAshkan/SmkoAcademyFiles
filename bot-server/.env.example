# Copy to .env and fill in. Never commit .env.

# @BotFather token and username
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SAFilesbot
# Long random value; also passed as secret_token when registering the webhook
TELEGRAM_WEBHOOK_SECRET=

# Your own app keys from my.telegram.org (used by the local Bot API server)
TG_API_ID=
TG_API_HASH=

APP_NAME=TelegramBot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bot.smkoacademy.ir
# During the move keep the old address too; afterwards only bot.smkoacademy.ir
BOT_DOMAINS=bot.smkoacademy.ir, tel-bot-server.binaries.ir

# The SMKO Files website, and the shared secret both sides use
APP_INTERNAL_BASE_URL=https://files.smkoacademy.ir
APP_INTERNAL_TOKEN=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

TELEGRAM_API_URL=http://bot-api:8081/bot

LOG_CHANNEL=stack
LOG_LEVEL=error
