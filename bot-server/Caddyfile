# The bot's web server (also handles HTTPS). BOT_DOMAINS lists every address it answers on —
# during the move: "bot.smkoacademy.ir, tel-bot-server.binaries.ir"; afterwards just bot.smkoacademy.ir.
{$BOT_DOMAINS:bot.smkoacademy.ir} {
    root * /var/www/html/public

    php_fastcgi bot-app:9000

    file_server

    encode gzip zstd

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
    }
}
